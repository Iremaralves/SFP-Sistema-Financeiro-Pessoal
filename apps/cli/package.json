{
  "name": "@i2fin/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "i2fin": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir bin --target bun --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@i2fin/core": "workspace:*",
    "@i2fin/db": "workspace:*",
    "@i2fin/schema": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
